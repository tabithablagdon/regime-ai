# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/

# Dependency lockfile artifacts that are fine to regenerate, not the lockfile itself
.uv-cache/

# Test / coverage
.pytest_cache/
.coverage
coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Env files
.env
.env.*
!.env.example

# Editor/IDE
.idea/
.vscode/
.DS_Store

# Generated forecast output (CLI writes these to the cwd)
forecast_*.md
forecast_*.json

# make up/down runtime state (pid file, API log)
.run/
