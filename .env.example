# LLM gateway (PRD §5.1, §14) — every agent and the Meta-Agent call through llm/client.py,
# which wraps OpenRouter today and can swap to a direct provider behind the same interface.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_FALLBACK_MODEL=

# Market data / fundamentals / news (PRD §5)
FMP_API_KEY=

# Embeddings for filing/news retrieval (PRD §5, §7.2)
VOYAGE_API_KEY=

# Postgres + pgvector (PRD §5, §13). Port 5433 matches docker-compose.yml's
# host mapping, chosen to avoid colliding with a default local Postgres on 5432.
DATABASE_URL=postgresql://equity_ensemble:equity_ensemble@localhost:5433/equity_ensemble

# Optional: LangSmith tracing of the LangGraph run (fan-out -> synthesize).
# Purely additive — leave both blank and nothing changes. Note this traces
# graph/node structure and timing only, not individual LLM prompts/
# completions: llm/client.py talks to OpenRouter directly over httpx,
# deliberately outside any LangChain model wrapper, so there's nothing
# LangChain-shaped for the tracer to see inside a node.
#
# The legacy LANGCHAIN_API_KEY / LANGCHAIN_PROJECT names (from LangSmith's
# own quickstart/older docs) work too — the client tries LANGSMITH_* first,
# then falls back to LANGCHAIN_*. Use whichever names your LangSmith
# account setup gave you; don't set both to different values.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=equity-ensemble
